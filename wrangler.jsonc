{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "daily-rhythm",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-19",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "secrets": {
    "required": ["GROQ_API_KEY"]
  }
}
